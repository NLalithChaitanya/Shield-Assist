# Shield Assist — Backend Environment Variables
# Copy to .env and fill in values.

# ── Database ──
# SQLite database path (relative to project root or absolute)
# SHIELD_ASSIST_DB_PATH=data/shield_assist.db

# ── CORS ──
# Set to your deployed frontend URL (e.g. https://your-app.vercel.app)
# Leave empty for wildcard CORS (development only).
FRONTEND_URL=

# ── Razorpay ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Gemini AI ──
GEMINI_API_KEY=

# ── Groq (optional failover) ──
GROQ_API_KEY=
