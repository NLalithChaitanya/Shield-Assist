# Shield Assist — Frontend Environment Variables
# For Vercel deployment, set VITE_API_URL in the Vercel dashboard
# (Settings → Environment Variables).

# Backend API base URL (REQUIRED for production)
# Leave empty for local development (Vite proxy handles API calls).
# Example: VITE_API_URL=https://your-backend.up.railway.app
VITE_API_URL=
